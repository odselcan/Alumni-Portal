@model Alumni_Portal.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Şifre Sıfırla"; Layout = null; }

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alumni Portal - Şifre Sıfırla</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: #eef0f5;
            display: flex; justify-content: center; align-items: center;
            min-height: 100vh; font-family: 'Segoe UI', sans-serif;
        }
        .card { width:440px;border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,0.12);border:none; }
        .card-header {
            background: linear-gradient(135deg, #e60000, #cc0000, #990000);
            border-radius: 16px 16px 0 0 !important;
            padding: 32px; text-align: center;
        }
        .form-control { border:1.5px solid #e0e0e0;border-radius:10px;padding:12px 16px;font-size:0.95rem; }
        .form-control:focus { border-color:#cc0000;box-shadow:0 0 0 3px rgba(204,0,0,0.1); }
        .btn-primary { background:#cc0000;border:none;border-radius:10px;padding:13px;font-weight:600; }
        .btn-primary:hover { background:#aa0000; }
    </style>
</head>
<body>
<div class="card">
    <div class="card-header">
        <h5 class="text-white mb-1 fw-bold">🔑 Yeni Şifre Belirle</h5>
        <small class="text-white opacity-75">Lütfen yeni şifrenizi girin</small>
    </div>
    <div class="card-body p-4">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-3">@TempData["Error"]</div>
        }
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label text-muted small">@L["NewPassword"]</label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label text-muted small">@L["ConfirmPassword"]</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">
                Şifremi Sıfırla
            </button>
        </form>
    </div>
</div>
</body>
</html>
