@model Alumni_Portal.ViewModels.LoginViewModel

@{
    ViewData["Title"] = L["Login"];
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alumni Portal - @L["Login"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: #eef0f5;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Segoe UI', sans-serif;
        }
        .login-wrapper {
            display: flex;
            width: 860px;
            min-height: 520px;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.12);
            background: white;
        }
        .login-form-side {
            flex: 1;
            padding: 52px 48px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .login-form-side .brand { color: #cc0000; font-size: 0.95rem; font-weight: 600; margin-bottom: 24px; }
        .login-form-side h2 { font-size: 1.9rem; font-weight: 700; color: #1a1a2e; margin-bottom: 6px; }
        .login-form-side .subtitle { color: #888; font-size: 0.92rem; margin-bottom: 32px; }
        .form-label { font-size: 0.85rem; color: #555; margin-bottom: 6px; }
        .form-control {
            border: 1.5px solid #e0e0e0;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 0.95rem;
        }
        .form-control:focus { border-color: #cc0000; box-shadow: 0 0 0 3px rgba(204,0,0,0.1); }
        .btn-login {
            background: #cc0000; color: white; border: none; border-radius: 10px;
            padding: 13px; font-size: 1rem; font-weight: 600; width: 100%; margin-top: 8px;
        }
        .btn-login:hover { background: #aa0000; }
        .login-banner-side {
            width: 340px;
            background: linear-gradient(135deg, #e60000 0%, #cc0000 50%, #990000 100%);
            display: flex; align-items: center; justify-content: center;
            padding: 48px 36px; border-radius: 0 16px 16px 0;
        }
        .login-banner-side h3 { color: white; font-size: 1.7rem; font-weight: 700; line-height: 1.4; }
        .text-danger { font-size: 0.82rem; }
        .alert { border-radius: 8px; font-size: 0.88rem; padding: 10px 14px; }
        .lang-selector { position: absolute; top: 20px; right: 24px; }
        .lang-btn {
            background: none; border: 1.5px solid #e0e0e0; border-radius: 8px;
            padding: 5px 10px; font-size: 0.82rem; cursor: pointer; color: #444;
        }
        .lang-btn:hover { border-color: #cc0000; color: #cc0000; }
        a { color: #cc0000; }
        a:hover { color: #aa0000; }
    </style>
</head>
<body>
    <div class="lang-selector">
        <div class="dropdown">
            @{
                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                var flag = currentCulture switch { "en-US" => "🇬🇧", "de-DE" => "🇩🇪", _ => "🇹🇷" };
            }
            <button class="lang-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">@flag</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/Language/Change?culture=tr-TR&returnUrl=/Login/Index">🇹🇷 Türkçe</a></li>
                <li><a class="dropdown-item" href="/Language/Change?culture=en-US&returnUrl=/Login/Index">🇬🇧 English</a></li>
                <li><a class="dropdown-item" href="/Language/Change?culture=de-DE&returnUrl=/Login/Index">🇩🇪 Deutsch</a></li>
            </ul>
        </div>
    </div>

    <div class="login-wrapper">
        <div class="login-form-side">
            <div class="brand">@L["GraduateManagementSystem"]</div>
            <h2>@L["WelcomeTitle"]</h2>
            <p class="subtitle">@L["LoginSubtitle"]</p>

            @if (TempData["Pending"] != null)
            {
                <div class="alert alert-warning mb-3"><i class="bi bi-hourglass-split me-2"></i>@TempData["Pending"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
            }

            <form asp-action="Index" asp-controller="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">@L["EmailAddress"]</label>
                    <input asp-for="Email" class="form-control" placeholder="ornek@universite.edu.tr" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">@L["Password"]</label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="text-end mb-3">
                    <a asp-controller="Login" asp-action="ForgotPassword" class="text-decoration-none small">@L["ForgotPassword"]</a>
                </div>
                <button type="submit" class="btn-login">@L["Login"]</button>
                <div class="text-center mt-3">
                    <a asp-controller="Register" asp-action="Index" class="text-decoration-none small">@L["NoAccount"]</a>
                </div>
            </form>
        </div>
        <div class="login-banner-side">
            <h3>@L["BannerText"]</h3>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
